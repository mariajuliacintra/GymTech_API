# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" NUNCA deve ir para o GitHub (ele já está no .gitignore).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gymtech
DEBUG=true

# Chave que assina os tokens de login (mínimo 32 caracteres).
# Gere uma com:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_gerada
# Tempo de validade do token, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Limite de tentativas de login erradas (academia, aluno e profissional).
LOGIN_MAX_TENTATIVAS=5
# Tempo de bloqueio depois de estourar o limite, em minutos.
LOGIN_BLOQUEIO_MINUTOS=15
