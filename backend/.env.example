# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo ".env" NUNCA deve ir para o GitHub (ele já está no .gitignore).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=gymtech
DEBUG=true

# Chave que assina os tokens de login (mínimo 32 caracteres).
# Gere uma com:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_gerada
# Tempo de validade do token, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Limite de tentativas de login erradas (academia, aluno e profissional).
LOGIN_MAX_TENTATIVAS=5
# Tempo de bloqueio depois de estourar o limite, em minutos.
LOGIN_BLOQUEIO_MINUTOS=15

# Fuso da academia: horários de aula (sem fuso) são entendidos neste fuso.
TIMEZONE=America/Sao_Paulo

# ---- Verificação de identidade (esqueci a senha / confirmar alterações) ----
# Código enviado por e-mail: validade em minutos, erros permitidos, intervalo
# entre envios (segundos) e espera após errar demais (minutos).
CODIGO_TTL_MINUTOS=10
CODIGO_MAX_TENTATIVAS=5
CODIGO_REENVIO_SEGUNDOS=60
CODIGO_BLOQUEIO_MINUTOS=15

# Envio de e-mail (SMTP). Passo a passo para usar uma conta Gmail:
#   1) ligue a "Verificação em duas etapas" na conta (myaccount.google.com/security);
#   2) crie uma "Senha de app" em myaccount.google.com/apppasswords (16 letras, sem espaços);
#   3) preencha abaixo. A senha NORMAL da conta não funciona.
# Em desenvolvimento pode deixar SMTP_HOST vazio: com DEBUG=true o e-mail
# (com o código) aparece no terminal, sem enviar nada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email_do_projeto@gmail.com
SMTP_PASSWORD=senha_de_app_de_16_letras
# Nome que aparece para quem recebe (o endereço tem de ser o do SMTP_USER):
SMTP_FROM=GymTech <seu_email_do_projeto@gmail.com>
SMTP_USE_TLS=true

# ---- Notificação de treinos próximos (e-mail diário) ----
# Liga ou desliga o agendador automático diário (true/false).
NOTIFICACAO_TREINO_ATIVO=true
# Horário diário do disparo automático (no fuso TIMEZONE acima). Padrão: 08:00.
NOTIFICACAO_TREINO_HORA=8
NOTIFICACAO_TREINO_MINUTO=0
# Quantos dias antes da data_programada avisar o aluno (1 = na véspera; 0 = no próprio dia).
NOTIFICACAO_TREINO_DIAS_ANTECEDENCIA=1
